{
  "name": "research-paper-qna",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run --workspace=apps/server dev",
    "dev:web": "npm run --workspace=apps/web dev",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "eval": "npm run --workspace=apps/server eval",
    "qdrant:stats": "node apps/server/scripts/check-qdrant.js",
    "qdrant:clear": "node apps/server/scripts/clear-except-attention.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
