# Server Configuration
PORT=3001

# Google Gemini API Key (Required for live multimodal PDF extraction & LLM synthesis)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cohere Rerank v3 API Key (Optional; improves dense/sparse rank fusion)
# Obtain from: https://cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# Qdrant Cloud Vector Database (Optional; falls back to in-memory hybrid retriever)
# Obtain from: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
